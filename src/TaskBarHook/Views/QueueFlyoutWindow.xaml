<Window x:Class="TaskBarHook.Views.QueueFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskBarHook.Queue"
        Width="260"
        Height="248"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource TaskBarHook.Surface}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        Foreground="{DynamicResource TaskBarHook.TextPrimary}"
        Focusable="True">
    <Border x:Name="RootBorder"
            Background="{DynamicResource TaskBarHook.Surface}"
            BorderBrush="{DynamicResource TaskBarHook.BorderSubtle}"
            BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="EnterTranslate" X="0" Y="0" />
        </Border.RenderTransform>
        <Grid Margin="8,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="HeaderText"
                       Text="{Binding Queue.HeaderText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TaskBarHook.TextSecondary}"
                       Margin="4,0,4,6" />
            <StackPanel Grid.Row="1" Visibility="{Binding Queue.ShowStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="StatusText"
                           Text="{Binding Queue.StatusText}"
                           FontSize="11"
                           Foreground="{DynamicResource TaskBarHook.TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="4,0,4,8" />
                <Button x:Name="ConnectButton"
                        Style="{StaticResource QuietTextButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="Conectar"
                        Command="{Binding Queue.ConnectCommand}"
                        Visibility="{Binding Queue.CanConnect, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Conectar ao Spotify" />
            </StackPanel>
            <ScrollViewer x:Name="QueueScroll"
                          Grid.Row="2"
                          MaxHeight="200"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="True"
                          PreviewMouseWheel="QueueScroll_OnPreviewMouseWheel"
                          Visibility="{Binding Queue.ShowList, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.Name="A seguir">
                <ItemsControl x:Name="QueueList" ItemsSource="{Binding Queue.Items}" IsHitTestVisible="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="4"
                                        Background="{DynamicResource TaskBarHook.SurfaceAlt}"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TaskBarHook.PlaceholderIcon}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasArtwork, Converter={StaticResource InverseBoolToVis}}" />
                                        <Image Source="{Binding Artwork}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip="{Binding Title}"
                                           ToolTipService.InitialShowDelay="600"
                                           ToolTipService.BetweenShowDelay="200" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
